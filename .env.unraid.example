# Copy to ".env" next to docker-compose.unraid.yml. Only DB_PASSWORD is required.

# Strong password for the bundled Postgres (letters/numbers only is safest).
DB_PASSWORD=change_me_to_a_long_random_string

# Address you open Prism at. Use your Unraid IP, or your https domain if proxied.
APP_URL=http://192.168.1.50:3000

# Your timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/London

# --- Optional -----------------------------------------------------------------
# PRISM_PORT=3000
# PRISM_IMAGE=ghcr.io/<your-github-user>/prism   # image built from this modified repo
# PRISM_VERSION=latest            # or pin e.g. 1.28.0
# PRISM_APPDATA=/mnt/user/appdata/prism
# PUID=99
# PGID=100

# Let Prism reach other things on your LAN (Immich, CalDAV, Tandoor...):
# PRISM_ALLOWED_INTERNAL_HOSTS="192.168.1.0/24"

# Secrets are generated automatically on first boot and stored in
# appdata/prism/config/.prism_secrets. Only set these to bring your own:
# SESSION_SECRET=
# PIN_ENCRYPTION_KEY=
# ENCRYPTION_KEY=

# Any other variables from .env.example (Google, Apple, weather...) can go here too.
